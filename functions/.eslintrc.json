{
  "root": true,
  "env": {
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "google"
  ],
  "rules": {
    "max-len": ["error", {"code": 120, "ignoreComments": true, "ignoreStrings": true, "ignoreUrls": true, "ignoreTemplateLiterals": true}],
    "comma-dangle": ["off"],
    "indent": ["error", 2],
    "quotes": ["error", "double"],
    "eol-last": ["error", "always"],
    "object-curly-spacing": ["error", "never"],
    "no-multi-spaces": "error",
    "semi": ["error", "always"]
  },
  "parserOptions": {
    "ecmaVersion": 2020
  }
}